# 99-flx10-unlock.rules -- send the DDJ-FLX10 its vendor unlock whenever it
# (re)appears on the bus, not only when start-rb.sh runs: a FLX10 that is power
# cycled or replugged mid-set otherwise comes back with NO AUDIO DRIVER on both
# jogs. Installed by install.sh to /etc/udev/rules.d/; flx10-unlock.py is the
# same script start-rb.sh runs (exit 0 sent, 1 failed, 2 absent).
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2b73", ATTR{idProduct}=="0041", RUN+="/usr/bin/python3 /opt/rblive4/flx10-unlock.py"
